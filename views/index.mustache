              alt="">
            <p>Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.
            </p>
            <div class="card-meta">
              <span>❤️ 80</span>
              <span>💬 18</span>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <div class="avatar"></div>
              <div class="user-info">
                <h4>PlayerFour</h4>
                <span class="time">12h ago</span>
