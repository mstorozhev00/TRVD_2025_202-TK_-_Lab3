  <title>VibeOn</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <div class="app">
    <aside class="sidebar">
      <div class="brand">
        <a href="/" class="logo-link">
          <div class="logo">VO</div>
          <h1>VibeOn</h1>
        </a>
      </div>
      <nav>
        <div class="divider muted">-</div>
        <a class="nav-item active" href="/">
          <i class="icon">🏠</i> <span class="label">Головна</span>
        </a>
        <a class="nav-item">
          <i class="icon">📖</i> <span class="label">Стрічка</span>
        </a>
        <a class="nav-item">
          <i class="icon">❤️</i> <span class="label">Улюблене</span>
        </a>
        <a class="nav-item">
          <i class="icon">💬</i> <span class="label">Чати</span>
          <span class="badge">15</span>
        </a>
        <div class="divider muted">База даних</div>
        <a class="nav-item" href="/users">
          <i class="icon">⚙️</i> <span class="label">Користувачі</span>
        </a>
